# 慧学平台环境变量样例 —— 全部为占位符，复制为 .env 后按需填写。
# 不配置任何真实密钥时，系统以离线 mock 模式运行（单测/评测均可跑通）。

# ---- 运行环境 ----
# test/offline 或缺少 OPENAI_API_KEY 时自动进入 mock 模式
APP_ENV=offline

# ---- 模型网关（OpenAI 兼容接口） ----
OPENAI_BASE_URL=https://<your-gateway-host>/v1
OPENAI_API_KEY=<your-api-key-here>
HUIXUE_MODEL_ROUTER=<small-model-name>
HUIXUE_MODEL_LESSON=<large-model-name>
HUIXUE_MODEL_QA=<large-model-name>
HUIXUE_MODEL_GRADING=<medium-model-name>
HUIXUE_MODEL_PROFILE=<medium-model-name>

# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg2://<db-user>:<db-password>@<db-host>:5432/<db-name>
# 置 1 可跳过落库（离线跑单测时使用）
SKIP_DB=0

# ---- 缓存 / 向量库 ----
REDIS_URL=redis://<redis-host>:6379/0
USE_MILVUS=0
MILVUS_HOST=<milvus-host>
MILVUS_PORT=19530
MILVUS_COLLECTION=huixue_corpus

# ---- 检索与路由参数（一般无需修改） ----
INTENT_THRESHOLD=0.92
CACHE_SIMILARITY_THRESHOLD=0.92
MAX_CLARIFY_ROUNDS=2
CORPUS_VERSION=v2026.03

# ---- API 访问 ----
# 内部服务间简单鉴权密钥，生产务必替换为强随机值
HUIXUE_API_KEY=<random-secret-here>
